{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open studio (editor + preview)",
      "type": "shell",
      "command": "~/Studio/studio.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Preview only (Jekyll)",
      "type": "shell",
      "command": "./bin/serve.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "Restart preview (clean)",
      "type": "shell",
      "command": "./bin/refresh.sh",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    }
  ]
}
